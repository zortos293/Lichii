; The installer's own strings, in the languages Lichii itself ships (dist/languages) and English.
; Every language needs every string: makensis /WX fails on a missing one.

; English
LangString OptionsTitle ${LANG_ENGLISH} "Options"
LangString OptionsSubtitle ${LANG_ENGLISH} "Choose the shortcuts and file types Lichii sets up."
LangString DesktopShortcut ${LANG_ENGLISH} "Create a desktop shortcut"
LangString FileTypes ${LANG_ENGLISH} "Open .nsp, .xci, .nro and .kip files with Lichii"
LangString Running ${LANG_ENGLISH} "Lichii is running from $INSTDIR. Close it, then try again."
LangString DeleteData ${LANG_ENGLISH} "Also delete your Lichii settings, keys, saves, mods and shader caches?"
LangString KeepData ${LANG_ENGLISH} "Keep them to find your settings and saves again after a later install."
LangString SharedData ${LANG_ENGLISH} "(also used by other Lichii copies, such as the zip)"

; Arabic
LangString OptionsTitle ${LANG_ARABIC} "خيارات"
LangString OptionsSubtitle ${LANG_ARABIC} "اختر الاختصارات وأنواع الملفات التي يُعدّها Lichii."
LangString DesktopShortcut ${LANG_ARABIC} "إنشاء اختصار على سطح المكتب"
LangString FileTypes ${LANG_ARABIC} "فتح ملفات .nsp و.xci و.nro و.kip باستخدام Lichii"
LangString Running ${LANG_ARABIC} "Lichii قيد التشغيل من $INSTDIR. أغلقه ثم حاول مرة أخرى."
LangString DeleteData ${LANG_ARABIC} "هل تريد أيضًا حذف إعدادات Lichii ومفاتيحه وحفظ الألعاب والتعديلات وذاكرة التخزين المؤقت للمظللات؟"
LangString KeepData ${LANG_ARABIC} "احتفظ بها لتستعيد إعداداتك وحفظ ألعابك عند تثبيت لاحق."
LangString SharedData ${LANG_ARABIC} "(تستخدمه أيضًا نسخ Lichii الأخرى، مثل نسخة zip)"

; Catalan
LangString OptionsTitle ${LANG_CATALAN} "Opcions"
LangString OptionsSubtitle ${LANG_CATALAN} "Trieu les dreceres i els tipus de fitxer que configura Lichii."
LangString DesktopShortcut ${LANG_CATALAN} "Crea una drecera a l'escriptori"
LangString FileTypes ${LANG_CATALAN} "Obre els fitxers .nsp, .xci, .nro i .kip amb Lichii"
LangString Running ${LANG_CATALAN} "Lichii s'està executant des de $INSTDIR. Tanqueu-lo i torneu-ho a provar."
LangString DeleteData ${LANG_CATALAN} "Voleu suprimir també la configuració, les claus, les partides desades, els mods i les memòries cau de shaders de Lichii?"
LangString KeepData ${LANG_CATALAN} "Conserveu-los per recuperar la configuració i les partides en una instal·lació futura."
LangString SharedData ${LANG_CATALAN} "(també el fan servir altres còpies de Lichii, com la del zip)"

; Czech
LangString OptionsTitle ${LANG_CZECH} "Možnosti"
LangString OptionsSubtitle ${LANG_CZECH} "Zvolte zástupce a typy souborů, které Lichii nastaví."
LangString DesktopShortcut ${LANG_CZECH} "Vytvořit zástupce na ploše"
LangString FileTypes ${LANG_CZECH} "Otevírat soubory .nsp, .xci, .nro a .kip v Lichii"
LangString Running ${LANG_CZECH} "Lichii je spuštěn ze složky $INSTDIR. Zavřete ho a zkuste to znovu."
LangString DeleteData ${LANG_CZECH} "Odstranit také nastavení, klíče, uložené hry, mody a mezipaměti shaderů Lichii?"
LangString KeepData ${LANG_CZECH} "Ponechte je, abyste po pozdější instalaci našli svá nastavení a uložené hry."
LangString SharedData ${LANG_CZECH} "(používají je i další kopie Lichii, například verze ze zipu)"

; Danish
LangString OptionsTitle ${LANG_DANISH} "Indstillinger"
LangString OptionsSubtitle ${LANG_DANISH} "Vælg de genveje og filtyper, Lichii opretter."
LangString DesktopShortcut ${LANG_DANISH} "Opret en genvej på skrivebordet"
LangString FileTypes ${LANG_DANISH} "Åbn .nsp-, .xci-, .nro- og .kip-filer med Lichii"
LangString Running ${LANG_DANISH} "Lichii kører fra $INSTDIR. Luk programmet, og prøv igen."
LangString DeleteData ${LANG_DANISH} "Vil du også slette dine Lichii-indstillinger, nøgler, gemte spil, mods og shader-cache?"
LangString KeepData ${LANG_DANISH} "Behold dem for at finde dine indstillinger og gemte spil igen efter en senere installation."
LangString SharedData ${LANG_DANISH} "(bruges også af andre Lichii-kopier, f.eks. zip-udgaven)"

; German
LangString OptionsTitle ${LANG_GERMAN} "Optionen"
LangString OptionsSubtitle ${LANG_GERMAN} "Wählen Sie die Verknüpfungen und Dateitypen, die Lichii einrichtet."
LangString DesktopShortcut ${LANG_GERMAN} "Desktop-Verknüpfung erstellen"
LangString FileTypes ${LANG_GERMAN} ".nsp-, .xci-, .nro- und .kip-Dateien mit Lichii öffnen"
LangString Running ${LANG_GERMAN} "Lichii wird aus $INSTDIR ausgeführt. Schließen Sie es und versuchen Sie es erneut."
LangString DeleteData ${LANG_GERMAN} "Auch Ihre Lichii-Einstellungen, Schlüssel, Spielstände, Mods und Shader-Caches löschen?"
LangString KeepData ${LANG_GERMAN} "Behalten Sie sie, um Ihre Einstellungen und Spielstände nach einer späteren Installation wiederzufinden."
LangString SharedData ${LANG_GERMAN} "(wird auch von anderen Lichii-Kopien verwendet, z. B. der ZIP-Version)"

; Greek
LangString OptionsTitle ${LANG_GREEK} "Επιλογές"
LangString OptionsSubtitle ${LANG_GREEK} "Επιλέξτε τις συντομεύσεις και τους τύπους αρχείων που ρυθμίζει το Lichii."
LangString DesktopShortcut ${LANG_GREEK} "Δημιουργία συντόμευσης στην επιφάνεια εργασίας"
LangString FileTypes ${LANG_GREEK} "Άνοιγμα αρχείων .nsp, .xci, .nro και .kip με το Lichii"
LangString Running ${LANG_GREEK} "Το Lichii εκτελείται από το $INSTDIR. Κλείστε το και δοκιμάστε ξανά."
LangString DeleteData ${LANG_GREEK} "Να διαγραφούν επίσης οι ρυθμίσεις, τα κλειδιά, οι αποθηκεύσεις, τα mods και οι κρυφές μνήμες shader του Lichii;"
LangString KeepData ${LANG_GREEK} "Κρατήστε τα για να βρείτε ξανά τις ρυθμίσεις και τις αποθηκεύσεις σας σε μια μελλοντική εγκατάσταση."
LangString SharedData ${LANG_GREEK} "(χρησιμοποιείται και από άλλα αντίγραφα του Lichii, όπως το zip)"

; Spanish
LangString OptionsTitle ${LANG_SPANISH} "Opciones"
LangString OptionsSubtitle ${LANG_SPANISH} "Elija los accesos directos y los tipos de archivo que Lichii configura."
LangString DesktopShortcut ${LANG_SPANISH} "Crear un acceso directo en el escritorio"
LangString FileTypes ${LANG_SPANISH} "Abrir los archivos .nsp, .xci, .nro y .kip con Lichii"
LangString Running ${LANG_SPANISH} "Lichii se está ejecutando desde $INSTDIR. Ciérrelo y vuelva a intentarlo."
LangString DeleteData ${LANG_SPANISH} "¿Eliminar también la configuración, las claves, las partidas guardadas, los mods y las cachés de sombreadores de Lichii?"
LangString KeepData ${LANG_SPANISH} "Consérvelos para recuperar su configuración y sus partidas en una instalación futura."
LangString SharedData ${LANG_SPANISH} "(también lo usan otras copias de Lichii, como la del zip)"

; Finnish
LangString OptionsTitle ${LANG_FINNISH} "Asetukset"
LangString OptionsSubtitle ${LANG_FINNISH} "Valitse pikakuvakkeet ja tiedostotyypit, jotka Lichii määrittää."
LangString DesktopShortcut ${LANG_FINNISH} "Luo pikakuvake työpöydälle"
LangString FileTypes ${LANG_FINNISH} "Avaa .nsp-, .xci-, .nro- ja .kip-tiedostot Lichiillä"
LangString Running ${LANG_FINNISH} "Lichii on käynnissä kansiosta $INSTDIR. Sulje se ja yritä uudelleen."
LangString DeleteData ${LANG_FINNISH} "Poistetaanko myös Lichiin asetukset, avaimet, tallennukset, modit ja varjostinvälimuistit?"
LangString KeepData ${LANG_FINNISH} "Säilytä ne, niin asetuksesi ja tallennuksesi löytyvät myöhemmän asennuksen jälkeen."
LangString SharedData ${LANG_FINNISH} "(myös muut Lichii-kopiot, kuten zip-versio, käyttävät tätä)"

; French
LangString OptionsTitle ${LANG_FRENCH} "Options"
LangString OptionsSubtitle ${LANG_FRENCH} "Choisissez les raccourcis et les types de fichiers que Lichii configure."
LangString DesktopShortcut ${LANG_FRENCH} "Créer un raccourci sur le bureau"
LangString FileTypes ${LANG_FRENCH} "Ouvrir les fichiers .nsp, .xci, .nro et .kip avec Lichii"
LangString Running ${LANG_FRENCH} "Lichii est en cours d'exécution depuis $INSTDIR. Fermez-le, puis réessayez."
