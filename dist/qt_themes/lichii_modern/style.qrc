<!-- Lichii Modern reuses the Lichii Dark stylesheet and icons; style.qss only adds to them. -->
<RCC>
    <qresource prefix="icons/lichii_modern">
        <file alias="index.theme">index.theme</file>
    </qresource>
    <qresource prefix="lichii_modern">
        <file>style.qss</file>
    </qresource>
</RCC>
