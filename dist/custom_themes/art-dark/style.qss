/* ==========================================================================
   Art Dark - an example theme for the themes folder.
   Copy this folder into <user folder>/themes, then pick it in
   Configure > General > UI > Theme. Saving this file updates the interface.

   Palette (search and replace to change a colour):
     window         #151816      surface        #1d201e
     raised         #262a27      border         #303531
     text           #e6eae6      muted text     #9ca69e
     accent         #82a88b      accent hover   #98bca0

   "theme:" is this folder: url("theme:icons/check.svg")
   ========================================================================== */
* {
    outline: 0;
}

QWidget {
    background-color: #151816;
    color: #e6eae6;
    selection-background-color: #82a88b;
    selection-color: #0d1a10;
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 9.5pt;
}

QWidget:disabled {
    color: #5e6660;
}

QLabel, QCheckBox, QRadioButton, QGroupBox {
    background: transparent;
}

QToolTip {
    background-color: #262a27;
    color: #e6eae6;
    border: 1px solid #303531;
    border-radius: 6px;
    padding: 5px 8px;
}

/* --- Menus ---------------------------------------------------------------- */

QMenuBar {
    background-color: #151816;
    border-bottom: 1px solid #232724;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #262a27;
}

QMenu {
    background-color: #1d201e;
    border: 1px solid #303531;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    background: transparent;
    padding: 6px 28px 6px 14px;
    border-radius: 5px;
}

QMenu::item:selected {
    background-color: #82a88b;
    color: #0d1a10;
}

QMenu::item:disabled {
    color: #5e6660;
}

QMenu::separator {
    height: 1px;
    background: #303531;
    margin: 5px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
    border: 1px solid #3b413c;
    border-radius: 4px;
    background: #151816;
}

QMenu::indicator:checked {
    background: #82a88b;
    border-color: #82a88b;
    image: url("theme:icons/check.svg");
}

QMenu::right-arrow {
    image: url("theme:icons/chevron-right.svg");
    width: 12px;
    height: 12px;
    margin-right: 6px;
}

/* --- Bars ---------------------------------------------------------------- */

QStatusBar {
    background-color: #151816;
    border-top: 1px solid #232724;
    color: #9ca69e;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #9ca69e;
}

/* Status bar buttons: text on a faint background. Checked = accent. */
QStatusBar QPushButton, QStatusBar QPushButton:flat {
    background-color: rgba(255, 255, 255, 10);
    border: none;
    border-radius: 4px;
    padding: 2px 7px;
    min-height: 0;
    color: #7f8a82;
}

QStatusBar QPushButton:hover {
    background-color: #232724;
    color: #e6eae6;
}

QStatusBar QPushButton:checked {
    background-color: rgba(130, 168, 139, 22);
    border: none;
    color: #82a88b;
}

QStatusBar QPushButton:checked:hover {
    background-color: #232724;
}

QStatusBar QPushButton:disabled {
    background-color: rgba(255, 255, 255, 5);
    border: none;
    color: #5e6660;
}

QToolBar {
    background-color: #151816;
    border: none;
    spacing: 4px;
    padding: 3px;
}

/* --- Buttons --------------------------------------------------------------- */

QPushButton {
    background-color: #262a27;
    border: 1px solid #303531;
    border-radius: 6px;
    padding: 5px 14px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #2e332f;
    border-color: #3b413c;
}

QPushButton:pressed {
    background-color: #1d201e;
}

QPushButton:default {
    background-color: #82a88b;
    border-color: #82a88b;
    color: #0d1a10;
}

QPushButton:default:hover {
    background-color: #98bca0;
    border-color: #98bca0;
}

QPushButton:checked {
    background-color: #2c3d31;
    border-color: #82a88b;
}

QPushButton:disabled {
    background-color: #1a1d1b;
    border-color: #232724;
    color: #5e6660;
}

QPushButton:flat {
    background: transparent;
    border-color: transparent;
}

QPushButton:flat:hover {
    background-color: #262a27;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 6px;
}

QToolButton:hover {
    background-color: #262a27;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #2c3d31;
    border-color: #82a88b;
}

/* --- Fields ---------------------------------------------------------------- */

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateTimeEdit, QKeySequenceEdit {
    background-color: #1d201e;
    border: 1px solid #303531;
    border-radius: 6px;
    padding: 4px 8px;
    selection-background-color: #82a88b;
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover,
QSpinBox:hover, QDoubleSpinBox:hover, QDateTimeEdit:hover {
    border-color: #3b413c;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QDateTimeEdit:focus {
    border-color: #82a88b;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #1a1d1b;
    border-color: #232724;
}

QSpinBox::up-button, QDoubleSpinBox::up-button, QDateTimeEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border: none;
    background: transparent;
}

QSpinBox::down-button, QDoubleSpinBox::down-button, QDateTimeEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border: none;
    background: transparent;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow, QDateTimeEdit::up-arrow {
    image: url("theme:icons/chevron-up.svg");
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow, QDateTimeEdit::down-arrow {
    image: url("theme:icons/chevron-down.svg");
    width: 10px;
    height: 10px;
}

QComboBox {
    background-color: #262a27;
    border: 1px solid #303531;
    border-radius: 6px;
    padding: 4px 28px 4px 10px;
    min-height: 18px;
}

QComboBox:hover {
    border-color: #3b413c;
    background-color: #2e332f;
}

QComboBox:focus, QComboBox:on {
    border-color: #82a88b;
}

QComboBox:disabled {
    background-color: #1a1d1b;
    border-color: #232724;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
}

QComboBox::down-arrow {
    image: url("theme:icons/chevron-down.svg");
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #1d201e;
    border: 1px solid #303531;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #82a88b;
    selection-color: #0d1a10;
}

/* --- Check boxes and radio buttons ------------------------------------------------ */

QCheckBox, QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator, QGroupBox::indicator,
QTreeView::indicator, QListView::indicator, QTableView::indicator {
    width: 15px;
    height: 15px;
    background-color: #1d201e;
    border: 1px solid #3b413c;
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover, QGroupBox::indicator:hover {
    border-color: #82a88b;
}

QCheckBox::indicator:checked, QGroupBox::indicator:checked,
QTreeView::indicator:checked, QListView::indicator:checked, QTableView::indicator:checked {
    background-color: #82a88b;
    border-color: #82a88b;
    image: url("theme:icons/check.svg");
}

QCheckBox::indicator:indeterminate, QTreeView::indicator:indeterminate {
    background-color: #2c3d31;
    border-color: #82a88b;
}

QRadioButton::indicator:checked {
    background-color: #ffffff;
    border: 4px solid #82a88b;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #1a1d1b;
    border-color: #303531;
}

QCheckBox::indicator:checked:disabled {
    background-color: #3b413c;
    border-color: #3b413c;
}

/* --- Groups and tabs ---------------------------------------------------- */

QGroupBox {
    border: 1px solid #2a2e2b;
    border-radius: 8px;
    margin-top: 12px;
    padding: 12px 8px 8px 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #9ca69e;
    background-color: #151816;
}

QTabWidget::pane {
    border: 1px solid #2a2e2b;
    border-radius: 8px;
    top: -1px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: #9ca69e;
    padding: 7px 14px;
    margin-right: 2px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: #e6eae6;
}

QTabBar::tab:selected {
    color: #ffffff;
    border-bottom: 2px solid #82a88b;
}

/* --- Lists, trees, tables ---------------------------------------------- */

QAbstractItemView {
    background-color: #191c1a;
    alternate-background-color: #1d201e;
    border: 1px solid #2a2e2b;
    border-radius: 8px;
    selection-background-color: #2c3d31;
    selection-color: #ffffff;
}

QTreeView::item, QListView::item, QTableView::item {
    padding: 4px 6px;
    border: none;
}

QTreeView::item:hover, QListView::item:hover, QTableView::item:hover {
    background-color: #232724;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background-color: #2c3d31;
    color: #ffffff;
}

QListWidget#selectorList::item, QListWidget::item {
    border-radius: 6px;
}

QHeaderView {
    background-color: transparent;
    border: none;
}

QHeaderView::section {
    background-color: #191c1a;
    color: #9ca69e;
    border: none;
    border-bottom: 1px solid #2a2e2b;
    padding: 7px 10px;
    font-weight: 600;
}

QHeaderView::section:hover {
    color: #e6eae6;
}

QTableCornerButton::section {
    background-color: #191c1a;
    border: none;
}

/* --- Scroll bars ------------------------------------------------------------ */

QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}

QScrollBar::handle {
    background-color: #3b413c;
    border-radius: 4px;
    min-width: 28px;
    min-height: 28px;
}

QScrollBar::handle:hover {
    background-color: #586259;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* --- Sliders and progress ----------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #303531;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #82a88b;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -6px 0;
    background-color: #ffffff;
    border: 1px solid #82a88b;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #e3efe5;
}

QSlider::groove:vertical {
    width: 4px;
    background-color: #303531;
    border-radius: 2px;
}

QSlider::handle:vertical {
    width: 14px;
    height: 14px;
    margin: 0 -6px;
    background-color: #ffffff;
    border: 1px solid #82a88b;
    border-radius: 8px;
}

QProgressBar {
    background-color: #1d201e;
    border: 1px solid #303531;
    border-radius: 6px;
    text-align: center;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #82a88b;
    border-radius: 5px;
}

/* --- Misc ---------------------------------------------------------------- */

QSplitter::handle {
    background-color: #232724;
}

QDockWidget::title {
    background-color: #1d201e;
    padding: 6px;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: #303531;
}

/* --- Performance overlay ---------------------------------------------------
   The overlay paints itself; these properties are its colours. Colours take
   #rrggbb or rgba(r, g, b, a) with a from 0 to 255. */

PerformanceOverlay {
    qproperty-backgroundColor: rgba(13, 16, 14, 140);
    qproperty-borderColor: #303531;
    qproperty-cornerRadius: 10;
    qproperty-textColor: #e6eae6;
    qproperty-mutedColor: #9ca69e;
    qproperty-dimColor: #7f8a82;
    qproperty-accentColor: #82a88b;
    qproperty-spikeColor: #e0705f;
    qproperty-lineColor: #cfe3d4;
    qproperty-axisColor: rgba(255, 255, 255, 40);
    qproperty-medianLineColor: rgba(255, 255, 255, 56);
}
