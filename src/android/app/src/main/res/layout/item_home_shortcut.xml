<?xml version="1.0" encoding="utf-8"?>
<!-- A round shortcut under the console-style home row, with its label below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/shortcut_button"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_margin="4dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/home_shortcut_background"
        app:cardCornerRadius="29dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/home_divider"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/shortcut_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/shortcut_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxWidth="80dp"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp" />

</LinearLayout>
