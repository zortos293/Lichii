#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D guest_scene;
layout(binding = 1, rgba8) uniform writeonly image2D reference_color;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(reference_color)))) {
        return;
    }
    vec3 linear = clamp(texelFetch(guest_scene, pixel, 0).rgb, 0.0, 1.0);
    vec3 srgb = mix(1.055 * pow(linear, vec3(1.0 / 2.4)) - 0.055,
                    12.92 * linear, lessThan(linear, vec3(0.0031308)));
    imageStore(reference_color, pixel, vec4(srgb, 1.0));
}
