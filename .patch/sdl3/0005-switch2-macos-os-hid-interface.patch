+#ifdef SDL_PLATFORM_MACOS
+/* Reads a number from the USB device behind an IOKit HID path ("DevSrvsID:<registry entry id>") */
+static bool GetIOKitUSBNumber(const char *path, CFStringRef key, UInt32 *value)
+{
+    bool result = false;
+
+    if (SDL_strncmp(path, "DevSrvsID:", 10) != 0) {
+        return false;
+    }
+    io_service_t service = IOServiceGetMatchingService(MACH_PORT_NULL, IORegistryEntryIDMatching(SDL_strtoull(path + 10, NULL, 10)));
+    if (service == MACH_PORT_NULL) {
+        return false;
+    }
+    CFTypeRef ref = IORegistryEntrySearchCFProperty(service, kIOServicePlane, key, kCFAllocatorDefault,
+                                                    kIORegistryIterateRecursively | kIORegistryIterateParents);
+    if (ref) {
+        result = CFGetTypeID(ref) == CFNumberGetTypeID() && CFNumberGetValue((CFNumberRef)ref, kCFNumberSInt32Type, value);
+        CFRelease(ref);
+    }
+    IOObjectRelease(service);
+    return result;
+}
+
+/* The HID interface was opened through IOKit, which leaves the vendor bulk interface free: open the
+ * same device with libusb, found by bus and address (libusb on macOS takes the bus number from the top
+ * byte of the location ID and the address from IOKit). */
+static bool OpenOwnBulkInterface(SDL_DriverSwitch2_Context *ctx, SDL_HIDAPI_Device *device)
+{
+    SDL_LibUSBContext *libusb = ctx->libusb;
+    libusb_device **list;
+    UInt32 location, address;
+
+    if (!GetIOKitUSBNumber(device->path, CFSTR("locationID"), &location) ||
+        !GetIOKitUSBNumber(device->path, CFSTR("USB Address"), &address)) {
+        return SDL_SetError("Couldn't find the USB address of the Switch 2 controller");
+    }
+    if (libusb->init(&ctx->own_usb_context) < 0) {
+        ctx->own_usb_context = NULL;
+        return SDL_SetError("Couldn't initialize libusb");
+    }
+    ssize_t count = libusb->get_device_list(ctx->own_usb_context, &list);
+    for (ssize_t i = 0; i < count; ++i) {
+        struct libusb_device_descriptor desc;
+        if (libusb->get_device_descriptor(list[i], &desc) < 0 ||
+            desc.idVendor != device->vendor_id || desc.idProduct != device->product_id ||
+            libusb->get_bus_number(list[i]) != (location >> 24) || libusb->get_device_address(list[i]) != address) {
+            continue;
+        }
+        // This is the controller behind the HID device: open it or fail
+        if (libusb->open(list[i], &ctx->device_handle) < 0) {
+            ctx->device_handle = NULL;
+        }
+        break;
+    }
+    if (count >= 0) {
+        libusb->free_device_list(list, 1);
+    }
+    if (!ctx->device_handle) {
+        libusb->exit(ctx->own_usb_context);
+        ctx->own_usb_context = NULL;
+        return SDL_SetError("Couldn't open the Switch 2 controller with libusb");
+    }
+    return true;
+}
